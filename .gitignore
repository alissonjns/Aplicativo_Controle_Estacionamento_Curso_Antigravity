.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*.sw?

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================
# SISTEMA OPERACIONAL
# =============================================
