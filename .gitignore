# =============================================
# AGENTES DE IA (CONFIGURACOES LOCAIS)
# =============================================
# A pasta .agents contem regras de IA locais - incluir ou excluir e uma decisao do time.
# Por padrao, excluimos a memoria dinamica (dados gerados em runtime) mas mantemos as regras.
.agents/memory/
.agents/mcp_config.json

